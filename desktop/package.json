{
  "name": "learnlocal-desktop",
  "version": "1.0.0",
  "description": "LearnLocal: offline AI learning system for classrooms with no internet",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:all": "electron-builder --win --mac"
  },
  "author": "LearnLocal",
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "org.optilearn.app",
    "productName": "LearnLocal",
    "copyright": "Copyright \u00a9 2025 LearnLocal contributors",
    "directories": {
      "output": "dist-electron",
      "buildResources": "assets"
    },
    "files": [
      "electron/**/*",
      "assets/**/*"
    ],
    "extraResources": [
      {
        "from": "../optilearn",
        "to": "optilearn",
        "filter": [
          "**/*",
          "!**/.venv/**",
          "!**/node_modules/**",
          "!**/frontend/node_modules/**",
          "!**/__pycache__/**",
          "!**/*.pyc",
          "!**/data/*.db",
          "!**/data/*.db-*",
          "!**/data/*.index",
          "!**/data/materials/**",
          "!**/data/ssl/**",
          "!**/data/voices/**",
          "!**/data/webview-profile/**",
          "!**/dist-electron/**",
          "!**/.env",
          "!**/.git/**"
        ]
      },
      {
        "from": "python-runtime",
        "to": "python-runtime",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "requestedExecutionLevel": "requireAdministrator"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "category": "public.app-category.education",
      "hardenedRuntime": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "LearnLocal"
    },
    "dmg": {
      "title": "LearnLocal Installer",
      "icon": "assets/icon.png",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  }
}
